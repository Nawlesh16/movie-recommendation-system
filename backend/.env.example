# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# "development" or "production"
NODE_ENV=development

# Port the API listens on
PORT=5000

# MongoDB connection string (local MongoDB shown; Atlas example is in README.md)
MONGODB_URI=mongodb://127.0.0.1:27017/movie_recommendation

# Secret used to sign JWTs. Use a long random string (32+ characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret-string

# How long a login token stays valid (examples: 15m, 12h, 7d)
JWT_EXPIRES_IN=7d

# Frontend URL that is allowed to call this API (CORS). Vite's default is 5173.
CLIENT_URL=http://localhost:5173

# TMDB (themoviedb.org) - used by backend/src/services/tmdb.service.js.
# Get a free API key at https://www.themoviedb.org/settings/api (the "API Key (v3 auth)" value).
# NEVER put this in the frontend's .env - only the backend calls TMDB.
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# Qdrant: local default is http://127.0.0.1:6333
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6ZTRlZTdjN2YtNzU2Ny00YjMwLThiMWItYzUzMWIwNDVhY2FkIn0.az5bVG31SW_51kxWerShS57jZZLZyacWRwfkf6CN3Fo
QDRANT_COLLECTION_NAME=movies

# Transformers.js embedding model. This model produces 384-dimensional vectors.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Hybrid recommendation weights. They are normalized at runtime.
BASELINE_RECOMMENDATION_WEIGHT=0.4
SEMANTIC_RECOMMENDATION_WEIGHT=0.6


# Neo4j graph layer (Phase 6). Leave blank to run without graph features.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password
NEO4J_DATABASE=neo4j
GRAPH_RECOMMENDATION_WEIGHT=0.25